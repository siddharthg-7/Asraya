# Application Environment Mode (development | staging | production)
VITE_ENV=development

# Application Title
VITE_APP_TITLE=Āśraya — Privacy-Preserving Proof Protocol

# Backend API Base URL (Used when VITE_ENABLE_MOCK_MODE=false)
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Enable Isolated Synthetic Demo / Mock Service Mode (true | false)
VITE_ENABLE_MOCK_MODE=true

# API Request Timeout in Milliseconds
VITE_API_TIMEOUT_MS=8000
