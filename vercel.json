{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm -w run build:vercel",
  "outputDirectory": "apps/wallet/dist",
  "installCommand": "pnpm install",
  "functions": {
    "api/index.ts": {
      "includeFiles": "circuits/build/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
