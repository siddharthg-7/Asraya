{
  "name": "pramana",
  "version": "0.1.0",
  "private": true,
  "description": "Pramāṇa — Privacy-Preserving Proof Protocol (Move the Question, Not the Data)",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:conformance": "vitest run tests/conformance",
    "verify:setup": "node --experimental-strip-types scripts/verify-setup.ts",
    "circuits:setup": "pnpm --filter @pramana/backend exec tsx ../scripts/setup-circuits.ts",
    "build:vercel": "pnpm run circuits:setup && tsc -b && pnpm --filter @pramana/frontend run build",
    "dev:frontend": "pnpm --filter @pramana/frontend run dev",
    "dev:backend": "pnpm --filter @pramana/backend run dev",
    "clean": "pnpm -r exec rimraf dist out *.tsbuildinfo"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
