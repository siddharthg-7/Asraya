# ==============================================================================
# Pramāṇa Environment Variables Configuration Template
# DO NOT ADD REAL SECRETS, CREDENTIALS, OR PRIVATE KEYS TO THIS FILE OR TO .env
# Copy this file to .env.<environment> for local configuration
# ==============================================================================

# Node Environment
# Options: development | test | production
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Monorepo Services Ports & Hosts (Development / Local Test Defaults)
# ------------------------------------------------------------------------------
WALLET_APP_PORT=3000
WALLET_APP_HOST=localhost

VERIFIER_APP_PORT=3001
VERIFIER_APP_HOST=localhost

REGISTRY_APP_PORT=3002
REGISTRY_APP_HOST=localhost

ISSUER_MOCK_SERVICE_PORT=3010
ISSUER_MOCK_SERVICE_HOST=localhost

ADAPTER_SERVICE_PORT=3011
ADAPTER_SERVICE_HOST=localhost

# ------------------------------------------------------------------------------
# 2. Registry & Trust Checkpoint Configuration
# ------------------------------------------------------------------------------
# Trust registry URL used by wallet and verifier to resolve issuer/verifier identities
REGISTRY_BASE_URL=http://localhost:3002/api/v1
# Trust checkpoint refresh interval in seconds
TRUST_CHECKPOINT_REFRESH_INTERVAL_SECONDS=300

# ------------------------------------------------------------------------------
# 3. Transport & Ephemeral Channels
# ------------------------------------------------------------------------------
# Maximum lifetime of ephemeral exchange sessions in seconds
EPHEMERAL_CHANNEL_TTL_SECONDS=120
# Nonce validity window in seconds to prevent replay attacks
NONCE_VALIDITY_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# 4. Storage & Persistence (Minimal Verifier-Side Model)
# ------------------------------------------------------------------------------
# In development/test: SQLite database file path or :memory:
# In production: Managed relational database connection string
DATABASE_URL=file:./dev.sqlite

# ------------------------------------------------------------------------------
# 5. Logging & Telemetry (Anti-Hallucination & Privacy Protection)
# ------------------------------------------------------------------------------
# LOG_LEVEL options: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Under NO circumstances should raw citizen attributes or decrypted credentials be logged
AUDIT_LOG_REDACTION_ENABLED=true

# ------------------------------------------------------------------------------
# 6. Cryptography & Zero-Knowledge Circuits Configuration
# ------------------------------------------------------------------------------
# Default proof tier: BBS (Tier A) with GROTH16 (Tier B) as fallback
DEFAULT_PROOF_TIER=BBS
CIRCUITS_ARTIFACTS_DIR=./circuits/build
